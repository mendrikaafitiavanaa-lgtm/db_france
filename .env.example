# Copie ce fichier en ".env" et remplis avec tes vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être commité (il est dans .gitignore).

# --- MongoDB local ---
MMONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=synchronisation
MONGO_SOURCE_COLLECTION=db_france
MONGO_TARGET_COLLECTION=db_france_region

# --- Réservé pour les étapes suivantes (laisser vide pour l'étape 1) ---
# GROQ_API_KEY=

# --- Paramètres de performance (config centralisée, cf. discussion) ---
BATCH_SIZE=100
PAUSE_SECONDES=0